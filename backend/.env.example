# Ooha Gifts API environment
PORT=5000
CORS_ORIGIN=*

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ooha_gifts

# Alternative: one connection URL (used when the DB_* values above are unset).
# DATABASE_URL=mysql://user:password@host:3306/ooha_gifts

# TLS for managed/hosted MySQL (auto-on for remote hosts, auto-off for localhost).
# Set explicitly to override: DB_SSL=true | DB_SSL=false
# DB_SSL=true

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES=7d

# Razorpay (leave empty to run in simulated test-payment mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp support number (with country code, no +)
WHATSAPP_NUMBER=919885927554
